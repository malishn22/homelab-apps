# Root path to the homelab repo on this machine (required for volume mounts).
# Example: ~/homelab
HOMELAB_ROOT=/path/to/homelab

# API service (host port)
MINECRAFT_API_PORT=<port>

# Web UI (host port : container port 80)
MINECRAFT_WEB_PORT=<port>

# Optional: backend env for containers the dashboard creates (default in compose: minecraft_instances)
MINECRAFT_INSTANCES_NETWORK=minecraft_instances

# Optional: if the backend needs CurseForge API (create .env from this and set real value)
CURSEFORGE_API_KEY=
CURSEFORGE_BASE_URL=https://api.curseforge.com/v1
