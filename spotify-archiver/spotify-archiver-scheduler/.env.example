SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:<port>/callback
# In Docker, this path is inside the mounted ./data volume for persistence
SPOTIFY_CACHE_PATH=./data/.spotify_cache

# --- PostgreSQL (used by docker-compose postgres service) ---
POSTGRES_DB=<db>
POSTGRES_USER=<user>
POSTGRES_PASSWORD=change-me
# Host port for local DB tools (set to whatever you expose it on)
POSTGRES_HOST_PORT=<port>

# For Docker: 'postgres' is the compose service name used as the host
DATABASE_URL=postgresql+psycopg://<user>:<password>@postgres:<port>/<db>

EXPORT_DIR=./exports
LOG_LEVEL=INFO
