# Spotify Archiver — web backend
#
# Credentials come from a Spotify app at https://developer.spotify.com/dashboard.
# SPOTIFY_REDIRECT_URI must match the redirect URI registered on that app exactly,
# including scheme, port, and trailing path — a mismatch fails the OAuth callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:<port>/callback

# Path *inside the container* where the OAuth token cache is written. It is bind-mounted
# from ./.spotify_token_cache, and the scheduler stack mounts that same directory — so
# both share one refreshed token. Changing this path breaks scheduled exports.
SPOTIFY_CACHE_PATH=/app/.spotify_cache_dir

# Points at the scheduler stack's PostgreSQL, reached by container name over the shared `homelab` network.
DATABASE_URL=postgresql://<user>:<password>@postgres:<port>/<db>

LOG_LEVEL=INFO
