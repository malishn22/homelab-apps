# Calimali — PostgreSQL connection
#
# DB_HOST is the *container name* of the database service, not localhost: the API
# reaches it over the shared `homelab` bridge network via Docker's embedded DNS.
# DB_PORT is the port inside the container (5432), not the published host port (5433).
DB_HOST=calimali-db
DB_PORT=5432
DB_NAME=calimali
DB_USER=calimali
DB_PASSWORD=change-me

# Calimali — JWT bearer auth (single user, no registration)
#
# ALL of these are required and treated as secrets: set real values in .env (gitignored),
# never commit them. The app uses only these env values — there are no built-in fallbacks.
JWT_KEY=change-me-min-32-chars
AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me
JWT_ISSUER=change-me
JWT_AUDIENCE=change-me
JWT_EXPIRY_DAYS=change-me
